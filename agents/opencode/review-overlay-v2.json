{
  "default_agent": "lcars-review-coordinator",
  "experimental": { "subagent_depth": 1 },
  "agents": {
    "lcars-review-coordinator": {
      "description": "Coordinate independent review passes, validate findings, and publish the review.",
      "mode": "primary",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "lcars-review", "effect": "allow" }
      ]
    },
    "lcars-review": {
      "description": "Run one independent code review pass or validate one finding and return the evidence.",
      "mode": "subagent",
      "steps": 12,
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
