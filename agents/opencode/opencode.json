{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./instructions.md"],
  "plugin": ["./lcars-session.js", "./bounded-read.js"],
  "skills": ["/opt/repo-tools/plugins/repo-tools/skills"],
  "permission": {
    "external_directory": "allow",
    "doom_loop": "allow",
    "task": "deny"
  },
  "compaction": {
    "reserved": 3000,
    "prune": true
  },
  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab LiteLLM (spark)",
      "options": {
        "baseURL": "https://llm.lan.jlapenna.net/v1",
        "apiKey": "{file:/run/secrets/opencode-llm-api-key}"
      },
      "models": {
        "default": {
          "name": "Spark Default (local production route). context 60000: see docs/opencode-context-limit.md - it is neither the backend's 262144 nor a guess, and changing it changes how often the agent loses its working memory.",
          "limit": {
            "context": 60000,
            "output": 8192
          }
        }
      }
    }
  }
}
