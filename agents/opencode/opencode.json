{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/instructions.md"],
  "plugin": ["./lcars-session.js", "./context-lifecycle.js"],
  "skills": ["/opt/repo-tools/plugins/repo-tools/skills"],
  "permission": {
    "external_directory": "allow",
    "doom_loop": "allow",
    "task": "deny"
  },
  "compaction": {
    "reserved": 30000,
    "prune": true
  },
  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab LiteLLM (spark)",
      "options": {
        "baseURL": "https://llm.lan.jlapenna.net/v1",
        "apiKey": "{file:/run/secrets/opencode-llm-api-key}"
      },
      "models": {
        "default": {
          "name": "Spark Default (Qwen production route; measured working budget: docs/opencode-context-limit.md)",
          "limit": {
            "context": 262144,
            "input": 110000,
            "output": 8192
          }
        }
      }
    }
  }
}
