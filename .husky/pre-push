#!/bin/bash

set -e

export NX_TUI=false
export NX_DAEMON=false

# core.hooksPath points at Husky, so Git LFS's generated .git/hooks/pre-push
# is never invoked on its own. Forward Git's untouched ref stream and remote
# arguments before any validation command has a chance to read stdin.
git lfs pre-push "$@"

./tools/require-feature-worktree.sh

./tools/check-dependencies.sh
./tools/nx format:check --base=origin/main
./tools/nx affected -t lint typecheck --base=origin/main
./tools/console-build-smoke.sh
