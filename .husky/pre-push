#!/bin/bash

set -e

export NX_TUI=false
export NX_DAEMON=false

# Git feeds pre-push one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# Capture it once and replay a copy to each consumer: the worktree guard
# reads it to exempt deletion-only pushes (all-zero local shas -- see the
# guard's own header, sprinkles#4296), and git lfs pre-push needs the same
# stream to know which refs to upload for.
refs="$(cat)"

# core.hooksPath points at Husky, so Git LFS's generated .git/hooks/pre-push
# is never invoked on its own. Replay Git's untouched ref stream and forward
# the remote arguments.
if [ -n "$refs" ]; then
  printf '%s\n' "$refs" | git lfs pre-push "$@"
else
  git lfs pre-push "$@" </dev/null
fi

printf '%s\n' "$refs" | repo-require-worktree pushes

./tools/check-dependencies.sh
./tools/nx format:check --base=origin/main
./tools/nx affected -t lint typecheck --base=origin/main
./tools/console-build-smoke.sh
