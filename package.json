{
  "name": "@repo/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "check:contracts": "vitest run --config tools/contract-tests/vitest.config.mts",
    "check:dependencies": "./tools/check-dependencies.sh",
    "check:labels": "node ./tools/sync-github-labels.mjs",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "lint": "nx run-many -t lint --all",
    "postinstall": "patch-package; . tools/cloud-build-prebuild.sh",
    "prepare": "if [ -z \"$CI\" ]; then pnpm exec husky; fi",
    "trajectory:collect": "node tools/trajectory-evaluation/cli.mjs collect",
    "trajectory:compare": "node tools/trajectory-evaluation/cli.mjs compare --corpus tools/trajectory-evaluation/corpus/v1/issue-523.json --variant tools/trajectory-evaluation/variants/issue-523-reliability-v1.json",
    "trajectory:report": "node tools/trajectory-evaluation/cli.mjs report --corpus tools/trajectory-evaluation/corpus/v1/issue-523.json",
    "trajectory:validate": "node tools/trajectory-evaluation/cli.mjs validate --corpus tools/trajectory-evaluation/corpus/v1/issue-523.json",
    "tsc": "nx run-many -t typecheck",
    "lint:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.base.json --exclude '.*(dist|test|spec).*' libs/ apps/",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:circular && nx run-many -t test typecheck build --all"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24",
    "pnpm": "10.34.5"
  },
  "dependencies": {
    "@google-cloud/firestore": "8.7.1",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/tasks": "^6.3.0",
    "@mantine/core": "^9.0.2",
    "@mantine/modals": "^9.0.2",
    "@mantine/notifications": "^9.0.2",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@tabler/icons-react": "^3.41.1",
    "chokidar": "^5.0.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.0.0",
    "google-auth-library": "^11.0.0",
    "google-gax": "6.0.0",
    "jose": "^6.2.8",
    "next": "~16.3.0",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@google/genai",
      "@parcel/watcher",
      "@swc/core",
      "core-js",
      "esbuild",
      "less",
      "nx",
      "protobufjs",
      "re2",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.2",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.1",
    "@naxodev/gonx": "4.1.1",
    "@next/eslint-plugin-next": "^16.2.4",
    "@nx/devkit": "23.1.1",
    "@nx/esbuild": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@playwright/test": "^1.59.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/eslint-plugin": "^1.6.23",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-tools": "^15.15.0",
    "firestore-jest-mock": "^0.26.0",
    "husky": "^9.1.7",
    "jest-fetch-mock": "^4.0.0",
    "jsonc-eslint-parser": "^3.1.0",
    "lint-staged": "^17.0.0",
    "madge": "^8.0.0",
    "nx": "23.1.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4",
    "yaml": "^2.9.0"
  }
}
