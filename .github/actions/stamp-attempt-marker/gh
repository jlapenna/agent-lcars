#!/usr/bin/env bash
# A `gh` wrapper that stamps this attempt's claim marker onto the pull
# request or comment a dispatched agent just created.
#
# Why this exists (agent-lcars#1213): verify-deliverable's clause 0 passes a
# broker-bound run ONLY when an artifact carries this run's exact
# `<!-- attempt-claim:<id> -->` marker, and until now the only thing putting
# that marker there was the agent transcribing a ~100-character literal out
# of its prompt. Agents forget. Run 31906618728 opened PR #1175, which was
# reviewed and merged - and because its body had no marker, the gate reported
# "no verifiable deliverable was found" and the projection told the operator
# the work "may be lost". The prompt already warned about exactly this, in
# capitals, and it happened anyway. A rule the model must remember is not a
# gate; this makes the marker a property of the artifact-creating command.
#
# This is NOT the time-window/login inference #815 deliberately refused. The
# marker is still stamped by the agent's own action, on the artifact that
# action created, inside the attempt that owns the ATTEMPT_ID - no guessing
# about whether some pre-existing artifact belongs to this run.
set -uo pipefail

self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Prefer the path the installer recorded; fall back to the next `gh` on PATH
# that is not this wrapper, so the wrapper still behaves exactly like `gh`
# even if it is invoked without the installer's environment.
resolve_real_gh() {
  if [ -n "${AGENT_GH_REAL:-}" ] && [ -x "${AGENT_GH_REAL}" ]; then
    printf '%s\n' "$AGENT_GH_REAL"
    return 0
  fi
  local candidate
  while IFS= read -r candidate; do
    if [ "$(cd "$(dirname "$candidate")" && pwd)" != "$self_dir" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(type -aP gh)
  return 1
}

if ! real_gh="$(resolve_real_gh)"; then
  echo "gh: no underlying gh executable found on PATH" >&2
  exit 127
fi

# True when the agent's own comment body carries the protocol's result marker,
# i.e. the agent is declaring THIS comment to be its deliverable. Reads the
# body from wherever gh would: --body/-b inline, or --body-file/-F (including
# `-` for stdin, which we must then replay so the real gh still receives it).
declares_a_result() {
  local previous='' argument body=''
  for argument in "$@"; do
    case "$previous" in
      --body | -b) body="$body$argument" ;;
      --body-file | -F)
        if [ "$argument" = - ]; then
          STDIN_BODY="$(cat)"
          body="$body$STDIN_BODY"
          REPLAY_STDIN=1
        elif [ -r "$argument" ]; then
          body="$body$(cat "$argument")"
        fi
        ;;
    esac
    previous="$argument"
  done
  case "$body" in *"<!-- agent-result:v1:"*) return 0 ;; esac
  return 1
}

# Inert unless the dispatching workflow opted this step in. The post-agent
# gates deliberately do NOT set it: they post comments with this same `gh`,
# and stamping those would let the deliverable gate satisfy itself with its
# own failure report.
if [ "${AGENT_MARKER_STAMPING:-}" != "1" ] || [ -z "${ATTEMPT_ID:-}" ]; then
  exec "$real_gh" "$@"
fi

# Only the subcommands that create an artifact clause 0 actually looks at.
# Anything else - including `gh api`, `gh pr view`, and the stamping calls
# below - passes straight through.
#
# `pr create` is unconditional: a pull request IS the deliverable on an
# implement dispatch, always.
#
# Comments are NOT, and stamping them unconditionally defeats the very gate
# this wrapper exists to feed. agent-protocol.md §5: "Stamp only the artifact
# that IS your deliverable, never your takeover or progress comment - the
# marker is a claim of authorship over one specific object, not a running
# commentary tag." The takeover comment is a run's FIRST action, so a wrapper
# that stamps every comment satisfies verify-deliverable before any work
# happens, on every run, forever. That regression shipped in #1213 and was
# caught in production on run 31950517581, whose takeover comment carried the
# marker - which is exactly what "silence is failure" is supposed to catch.
#
# So a comment is stamped only when the agent has already declared it to be a
# result, using the protocol's own machine-readable signal
# (`<!-- agent-result:v1:... -->`). That covers the evidence-backed no-op,
# whose whole deliverable is a comment. Park needs no marker at all -
# verify-deliverable clause (c) recognizes it by the status:needs-human
# label. A reply dispatch's comment still needs the agent's own marker, the
# same as before this wrapper existed: this narrows the wrapper, it does not
# take anything away that used to work.
case "${1:-} ${2:-}" in
  "pr create") artifact_kind=pull-request ;;
  "issue comment" | "pr comment") artifact_kind=comment ;;
  *) exec "$real_gh" "$@" ;;
esac

if [ "$artifact_kind" = comment ] && ! declares_a_result "$@"; then
  exec "$real_gh" "$@"
fi

marker="<!-- attempt-claim:${ATTEMPT_ID} -->"

# Run the real command first and relay its output verbatim: the agent reads
# the printed URL, and nothing below may change what it sees or the status it
# gets back. Stderr is not captured, so it streams through untouched.
if [ -n "${REPLAY_STDIN:-}" ]; then
  output="$(printf '%s' "$STDIN_BODY" | "$real_gh" "$@")"
else
  output="$("$real_gh" "$@")"
fi
status=$?
if [ -n "$output" ]; then
  printf '%s\n' "$output"
fi
if [ "$status" -ne 0 ]; then
  exit "$status"
fi

if [ "$artifact_kind" = pull-request ]; then
  url="$(grep -Eo 'https://[^[:space:]]+/pull/[0-9]+' <<<"$output" | tail -n 1)"
else
  url="$(grep -Eo 'https://[^[:space:]]+issuecomment-[0-9]+' <<<"$output" | tail -n 1)"
fi

stamp_pull_request() {
  local body
  body="$("$real_gh" pr view "$url" --json body --jq .body)" || return 1
  case "$body" in *"$marker"*) return 0 ;; esac
  "$real_gh" pr edit "$url" --body "$body"$'\n\n'"$marker" >/dev/null || return 1
}

stamp_comment() {
  local repo id body
  repo="$(awk -F/ '{print $4"/"$5}' <<<"$url")"
  id="${url##*issuecomment-}"
  [[ "$repo" == */* ]] && [[ "$id" =~ ^[0-9]+$ ]] || return 1
  body="$("$real_gh" api "repos/$repo/issues/comments/$id" --jq .body)" || return 1
  case "$body" in *"$marker"*) return 0 ;; esac
  "$real_gh" api --method PATCH "repos/$repo/issues/comments/$id" \
    -f "body=$body"$'\n\n'"$marker" >/dev/null || return 1
}

# Best effort, always: the agent's command already succeeded, and its exit
# status is the contract with the agent. A failure here costs the run its
# clause-0 evidence, so it is loud in the log - but it must never turn a
# created artifact into a failed command.
if [ -z "$url" ]; then
  echo "::warning::Created a $artifact_kind but found no URL in gh's output; this run's attempt-claim marker was not stamped." >&2
elif [ "$artifact_kind" = pull-request ] && ! stamp_pull_request; then
  echo "::warning::Could not stamp this run's attempt-claim marker onto $url; verify-deliverable will not count it." >&2
elif [ "$artifact_kind" = comment ] && ! stamp_comment; then
  echo "::warning::Could not stamp this run's attempt-claim marker onto $url; verify-deliverable will not count it." >&2
fi

exit 0
