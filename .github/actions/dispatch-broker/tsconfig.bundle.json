{
  // Stage 1 of the TS migration (no language change yet -- see
  // .github/actions/project.json's `build` target): main.mjs and everything
  // it imports are still plain ESM JavaScript, not TypeScript. @nx/esbuild's
  // executor schema requires a `tsConfig` regardless, and reads it (via
  // `readTsConfig`) even though `skipTypeCheck: true` on the target means
  // tsc itself never actually runs -- so this only needs to be valid enough
  // for esbuild's own tsconfig-derived settings (module resolution, target)
  // to make sense for a Node ESM bundle. It is not, and must not become, a
  // real typecheck config; Stage 2 adds that when the sources themselves
  // become TypeScript.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "composite": false,
    "skipLibCheck": true,
    "types": []
  }
}
