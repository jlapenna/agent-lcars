{
  "name": "@agent-lcars/work",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/work/src",
  "projectType": "library",
  "tags": ["platform:shared", "scope:shared"],
  "targets": {
    "openapi-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx tools/work-openapi.mts --check"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^typecheck"],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "outputs": [
        "{projectRoot}/tsconfig.tsbuildinfo",
        "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}",
        "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo",
        "{projectRoot}/dist/tsconfig.spec.tsbuildinfo"
      ],
      "options": {
        "cwd": "libs/work",
        "command": "tsc --build tsconfig.json --emitDeclarationOnly"
      }
    }
  }
}
