{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jlapenna/agent-lcars/tools/trajectory-evaluation/schema/variant-v1.schema.json",
  "title": "Agent LCARS offline trajectory variant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "variantId",
    "kind",
    "description",
    "rules",
    "reviewedExpectations"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-lcars.trajectory-variant/v1" },
    "variantId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["prompt", "setup", "prompt-and-setup"] },
    "description": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockSetupOutcomes",
        "structuredNoOp",
        "maxNoArtifactMinutes"
      ],
      "properties": {
        "blockSetupOutcomes": {
          "type": "array",
          "items": {
            "enum": [
              "credential-failure",
              "provider-failure",
              "bootstrap-failure"
            ]
          }
        },
        "structuredNoOp": { "type": "boolean" },
        "maxNoArtifactMinutes": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "reviewedExpectations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "useful",
          "accepted",
          "confidence",
          "reviewer",
          "reviewedAt",
          "rationale"
        ],
        "properties": {
          "kind": {
            "enum": [
              "startup-failure",
              "provider-failure",
              "trajectory-failure",
              "correct-park",
              "correct-no-op",
              "outcome-gate-failure",
              "merged-deliverable",
              "superseded-duplicate",
              "unknown-success"
            ]
          },
          "useful": { "type": "boolean" },
          "accepted": { "type": "boolean" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "protocolAdherent": { "type": "boolean" },
          "trajectoryOutcome": {
            "enum": [
              "not-started",
              "productive",
              "loop",
              "tool-failure",
              "provider-delay",
              "unknown"
            ]
          },
          "firstArtifactSeconds": { "type": ["number", "null"], "minimum": 0 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
