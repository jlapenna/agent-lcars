{
  "name": "@agent-lcars/console-e2e",
  "tags": ["platform:web", "scope:console"],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/console-e2e/src",
  "implicitDependencies": ["@agent-lcars/console"],
  "targets": {
    "killports": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./tools/kill-e2e-ports.sh"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "emulator",
      "configurations": {
        "emulator": {},
        "live": {
          "command": "./tools/e2e/reject-live.sh"
        }
      },
      "options": {
        "command": "./tools/e2e-local.sh",
        "env": {
          "E2E_PROJECT": "@agent-lcars/console-e2e"
        }
      }
    },
    "e2e-implementation": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "emulator",
      "dependsOn": [
        "@agent-lcars/console-e2e:e2e-build-hermetic",
        "@agent-lcars/console-e2e:killports"
      ],
      "configurations": {
        "emulator": {
          "command": "node tools/e2e/validate-env.mjs --require-hermetic --next-root apps/console \"${E2E_ENV_FILE:-.env.e2e}\" \"${E2E_ENV_LOCAL_FILE:-.env.e2e.local}\" && pnpm exec dotenv -e \"${E2E_ENV_FILE:-.env.e2e}\" -e \"${E2E_ENV_LOCAL_FILE:-.env.e2e.local}\" --optional -- pnpm exec firebase emulators:exec --only auth,firestore,eventarc --project=demo-no-project \"pnpm exec nx run @agent-lcars/console-e2e:e2e-run\""
        },
        "live": {
          "command": "./tools/e2e/reject-live.sh"
        }
      },
      "options": {
        "forwardAllArgs": false,
        "parallel": false,
        "env": {
          "AUTH_URL": "http://localhost:4200",
          "E2E_TESTING": "true",
          "AGENT_CONSOLE_GITHUB_API_BASE_URL": "http://localhost:4200/api/e2e/github"
        }
      }
    },
    "e2e-build-hermetic": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/e2e/validate-env.mjs --require-hermetic --next-root apps/console \"${E2E_ENV_FILE:-.env.e2e}\" \"${E2E_ENV_LOCAL_FILE:-.env.e2e.local}\" && pnpm exec nx run @agent-lcars/console:bundle"
      }
    },
    "e2e-local": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "emulator",
      "configurations": {
        "emulator": {},
        "live": {
          "command": "./tools/e2e/reject-live.sh"
        }
      },
      "options": {
        "command": "./tools/e2e-local.sh",
        "env": {
          "E2E_PROJECT": "@agent-lcars/console-e2e"
        }
      }
    },
    "e2e-run": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/dist/.playwright/apps/console-e2e"],
      "options": {
        "config": "apps/console-e2e/playwright.config.ts",
        "skipInstall": true
      }
    },
    "e2e-docker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./tools/e2e-docker.sh @agent-lcars/console-e2e"
      }
    }
  }
}
