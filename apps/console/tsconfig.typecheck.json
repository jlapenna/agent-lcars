{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "composite": false,
    "incremental": false,
    "rootDir": "../..",
    "tsBuildInfoFile": null,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@/*": ["apps/console/src/*"],
      "@agent-lcars/util": ["libs/util/src/index.ts"],
      "@agent-lcars/logging": ["libs/logging/src/index.ts"],
      "@agent-lcars/logging/browser": ["libs/logging/src/browser/index.ts"],
      "@agent-lcars/logging/error-reporting": [
        "libs/logging/src/error-reporting.ts"
      ],
      "@agent-lcars/logging/server": ["libs/logging/src/server/index.ts"],
      "@agent-lcars/env": ["libs/env-vars/src/index.ts"],
      "@agent-lcars/util-server": ["libs/util-server/src/index.ts"],
      "@agent-lcars/app-providers": ["libs/app-providers/src/index.ts"],
      "@agent-lcars/dispatch-contracts": [
        "libs/dispatch-contracts/src/index.ts"
      ],
      "@agent-lcars/orchestrator": ["libs/orchestrator/src/index.ts"],
      "@agent-lcars/telemetry": ["libs/telemetry/src/index.ts"],
      "@agent-lcars/telemetry/server": ["libs/telemetry/src/server/index.ts"]
    }
  },
  "references": []
}
