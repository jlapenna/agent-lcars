{
  "name": "@agent-lcars/console",
  "tags": ["platform:nextjs", "scope:console"],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/console/src",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/console",
        "command": "tsc --noEmit -p tsconfig.typecheck.json"
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "inputs": [
        "production",
        "^production",
        { "env": "NEXT_PUBLIC_PROJECT_ID" },
        { "env": "NEXT_PUBLIC_FIREBASE_API_KEY" },
        { "env": "NEXT_PUBLIC_FIREBASE_APP_ID" },
        { "env": "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN" },
        { "env": "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID" },
        { "env": "NEXT_PUBLIC_FIREBASE_PROJECT_ID" },
        { "env": "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET" },
        { "env": "NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST" },
        { "env": "NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST" }
      ],
      "options": {
        "outputPath": "dist/apps/console",
        "tsConfig": "apps/console/tsconfig.json",
        "assets": ["apps/console/public"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        },
        "development": {
          "debug": true
        }
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "mkdir -p dist/apps/console/.next/standalone/dist/apps/console/.next dist/apps/console/.next/standalone/apps/console",
          "cp -r dist/apps/console/public dist/apps/console/.next/standalone/apps/console/",
          "cp -r dist/apps/console/.next/static dist/apps/console/.next/standalone/dist/apps/console/.next/"
        ],
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase deploy --project=agent-lcars --only apphosting:agent-lcars"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "@agent-lcars/console:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "@agent-lcars/console:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "@agent-lcars/console:build:production",
          "dev": false
        }
      }
    },
    "serve-production": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "options": {
        "command": "pnpm exec dotenv -e .env.development.local --optional -- node dist/apps/console/.next/standalone/apps/console/server.js",
        "env": {
          "PORT": "4203",
          "HOSTNAME": "127.0.0.1",
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "capture-session": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/saved-session/capture.mjs",
        "forwardAllArgs": true
      }
    },
    "mint-session": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/saved-session/mint.mjs",
        "forwardAllArgs": true
      }
    },
    "verify-session": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/saved-session/verify.mjs",
        "forwardAllArgs": true
      }
    }
  }
}
