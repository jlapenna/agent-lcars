{
  "name": "@agent-lcars/console",
  "tags": ["platform:nextjs", "scope:console"],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "nativePlatform": [
      {
        "runtime": "node -p \"JSON.stringify([process.platform, process.arch, process.versions.modules, process.platform === 'linux' ? process.report.getReport().header.glibcVersionRuntime || 'musl' : ''])\""
      }
    ],
    "ciBuild": [
      {
        "runtime": "node -p \"['1', 'true'].includes(process.env.CI || '')\""
      }
    ]
  },
  "sourceRoot": "apps/console/src",
  "projectType": "application",
  "targets": {
    "serve-emulator": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "node tools/dev-console.mjs start",
        "forwardAllArgs": true
      }
    },
    "serve-lan": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "node tools/dev-console.mjs start --lan",
        "forwardAllArgs": true
      }
    },
    "dev-reset": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/dev-console.mjs reset",
        "forwardAllArgs": true
      }
    },
    "dev-status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/dev-console.mjs status",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/console",
        "command": "tsc --noEmit -p tsconfig.typecheck.json"
      }
    },
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/console/.next"],
      "defaultConfiguration": "production",
      "inputs": ["production", "^production", "nativePlatform", "ciBuild"],
      "configurations": {
        "production": {},
        "development": {
          "args": ["--debug"]
        }
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["production", "^production", "nativePlatform", "ciBuild"],
      "options": {
        "commands": [
          "mkdir -p dist/apps/console/.next/standalone/dist/apps/console/.next dist/apps/console/.next/standalone/apps/console",
          "cp -r apps/console/public dist/apps/console/.next/standalone/apps/console/",
          "cp -r dist/apps/console/.next/static dist/apps/console/.next/standalone/dist/apps/console/.next/"
        ],
        "parallel": false
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/console/.next/standalone/apps/console/public",
        "{workspaceRoot}/dist/apps/console/.next/standalone/dist/apps/console/.next/static"
      ]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase deploy --project=agent-lcars --only apphosting:agent-lcars"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve-production": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "options": {
        "command": "pnpm exec dotenv -e .env.development.local --optional -- node dist/apps/console/.next/standalone/apps/console/server.js",
        "env": {
          "PORT": "4203",
          "HOSTNAME": "127.0.0.1",
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "capture-session": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/saved-session/capture.mjs",
        "forwardAllArgs": true
      }
    },
    "mint-session": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/saved-session/mint.mjs",
        "forwardAllArgs": true
      }
    },
    "check-session": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/saved-session/check.mjs",
        "forwardAllArgs": true
      }
    },
    "verify-session": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/saved-session/verify.mjs",
        "forwardAllArgs": true
      }
    }
  }
}
