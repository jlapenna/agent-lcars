{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/dispatch-broker-spec",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    // Deliberately looser than tsconfig.app.json, which typechecks the same
    // sources strictly. These suites exist partly to prove the runtime
    // validators reject malformed input, so they pass deliberately-invalid
    // shapes on purpose -- `{ generations: [null] }`, a task with no
    // repositoryId, an unknown reason code. Under strict typing every one of
    // those needs a cast that says nothing except "yes, I meant it", which
    // buries the handful of casts that carry real information.
    "noImplicitAny": false
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
