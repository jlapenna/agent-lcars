{
  "name": "@agent-lcars/runner-autoscaler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/runner-autoscaler",
  "projectType": "application",
  "tags": ["platform:server", "scope:console"],
  "targets": {
    "build": {
      "executor": "@naxodev/gonx:build",
      "options": {
        "flags": ["-buildvcs=false"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/go.work",
        "{workspaceRoot}/go.work.sum",
        { "runtime": "go version" },
        {
          "runtime": "go env GOOS GOARCH CGO_ENABLED GOFLAGS GOEXPERIMENT CGO_CFLAGS CGO_CPPFLAGS CGO_CXXFLAGS CGO_LDFLAGS"
        }
      ],
      "outputs": [],
      "options": {
        "command": "go vet ./...",
        "cwd": "apps/runner-autoscaler"
      }
    },
    "test": {
      "inputs": [
        "goSource",
        "^goSource",
        "{workspaceRoot}/apps/console/src/lib/runner-status-contract.ts"
      ]
    },
    "test-race": {
      "executor": "@naxodev/gonx:test",
      "cache": true,
      "dependsOn": ["generate", "^build"],
      "inputs": [
        "goSource",
        "^goSource",
        "{workspaceRoot}/apps/console/src/lib/runner-status-contract.ts"
      ],
      "options": {
        "race": true
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docker build -t agent-lcars-runner-autoscaler:local .",
        "cwd": "apps/runner-autoscaler"
      }
    },
    "runner-image-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t agent-lcars-runner:local .",
        "cwd": "apps/runner-autoscaler/runner-image"
      }
    }
  }
}
