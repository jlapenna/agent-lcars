{
  "name": "@agent-lcars/telemetry-watcher",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/telemetry-watcher/src",
  "projectType": "application",
  "tags": ["platform:server", "scope:console"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "apps/telemetry-watcher/dist",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "main": "apps/telemetry-watcher/src/main.ts",
        "tsConfig": "apps/telemetry-watcher/tsconfig.build.json",
        "assets": ["apps/telemetry-watcher/src/assets"],
        "skipTypeCheck": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          },
          "external": ["@google-cloud/*", "google-gax"]
        }
      }
    },
    "bundle": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/telemetry-watcher",
        "outputFileName": "sidecar.cjs",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "target": "node24",
        "main": "apps/telemetry-watcher/src/main.ts",
        "tsConfig": "apps/telemetry-watcher/tsconfig.build.json",
        "skipTypeCheck": true,
        "esbuildOptions": {
          "alias": {
            "abort-controller": "apps/telemetry-watcher/src/lib/native-abort-controller-shim.cjs"
          },
          "sourcemap": false
        }
      }
    },
    "session-title-cli": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/telemetry-watcher-session-title-cli",
        "outputFileName": "lcars-session-title.cjs",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "target": "node24",
        "main": "apps/telemetry-watcher/src/session-title-cli.ts",
        "tsConfig": "apps/telemetry-watcher/tsconfig.build.json",
        "skipTypeCheck": true,
        "esbuildOptions": {
          "sourcemap": false
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false
          }
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "hook-cli": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/telemetry-watcher-hook",
        "outputFileName": "lcars-hook.cjs",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "target": "node24",
        "main": "apps/telemetry-watcher/src/hook-cli.ts",
        "tsConfig": "apps/telemetry-watcher/tsconfig.build.json",
        "skipTypeCheck": true,
        "esbuildOptions": {
          "sourcemap": false
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false
          }
        }
      }
    },
    "hook-flush-cli": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/telemetry-watcher-hook-flush",
        "outputFileName": "lcars-hook-flush.cjs",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "target": "node24",
        "main": "apps/telemetry-watcher/src/hook-flush-cli.ts",
        "tsConfig": "apps/telemetry-watcher/tsconfig.build.json",
        "skipTypeCheck": true,
        "esbuildOptions": {
          "sourcemap": false
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false
          }
        }
      }
    }
  }
}
