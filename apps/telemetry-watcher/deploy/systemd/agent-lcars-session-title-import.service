# Agent LCARS: import Codex native session titles from the host state DB
# (issue #1212). Codex's own titles (`threads.name`/`threads.title`) live
# only in `~/.codex/state_*.sqlite`, which is WAL-mode -- a read-only bind
# mount of it fails outright (`ERR_SQLITE_ERROR: attempt to write a
# readonly database`, verified), and mounting `~/.codex` itself instead
# would also expose `auth.json`/`history.jsonl` to the watcher container,
# breaching this deployment's privacy boundary (see docker-compose.yml's
# AGENT_TELEMETRY_SESSION_STATE_DIR comment). So the import runs here, on
# the host, as the same account whose Codex DB it's reading, and writes one
# small JSON file per session under `~/.local/state/agent-lcars/native-titles/`
# -- which the watcher container mounts read-only like everything else it
# reads.
#
# This is a systemd **user** unit: install it under the WATCHER_USER
# account itself (the account deploy.sh derives WATCHER_UID/GID/HOME from,
# `jlapenna` by default) -- see deploy/README.md for install steps. It must
# NOT be run as the separate `homelab` deploy account deploy.sh otherwise
# runs as: that account has neither read access to this Codex DB nor
# write access to the state root deploy.sh pre-creates for WATCHER_USER.
[Unit]
Description=Import Codex native session titles for Agent LCARS
Documentation=https://github.com/jlapenna/agent-lcars/blob/main/apps/telemetry-watcher/deploy/README.md

[Service]
Type=oneshot
# `-` (systemd.service(5) exec prefix) drops the exit code from unit-state
# bookkeeping: a missing/locked Codex state DB is an expected, common case
# (not every host runs Codex, and a live Codex process can hold the DB
# briefly) and must not flip this unit -- or the timer that re-arms it --
# to `failed`. `session import-native` already fails soft internally on a
# missing file, a renamed column, or a lock (same contract as the watcher's
# other optional SQLite source, `antigravity-summary-source.ts`); the `-`
# here is a second, redundant layer against a failure mode this deploy
# config can't anticipate from the app side, e.g. the CLI not having been
# installed yet (see below). Real failures are still visible in
# `journalctl --user -u agent-lcars-session-title-import.service` --
# this only keeps the unit's own success/failure status from flapping on
# the benign, expected case.
#
# ExecStart points at the STABLE INSTALLED launcher
# (`../install-session-title-cli.sh`'s `$BIN_DIR/lcars`,
# `~/.local/bin/lcars` by default), never at a checkout's `dist/`: the
# primary checkout this repo is normally cloned into on a watcher host
# (`~/p/agent-lcars`) is guardrail-reserved for a clean `main`, and
# `git clean -xfd` there erases a `dist/` build artifact outright, which
# would otherwise silently break this unit. The launcher also owns Node
# resolution (this fleet's Node is fnm-managed, and fnm's shim lives in a
# per-shell path a systemd --user unit's own minimal PATH can't see) so
# that logic lives in exactly one place rather than being duplicated here.
#
# Until `install-session-title-cli.sh` has been run at least once, this
# path doesn't exist yet, the unit fails, and -- per the `-` prefix above
# -- that failure is silently absorbed and the timer just tries again in 2
# minutes.
ExecStart=-%h/.local/bin/lcars session import-native
# One pass over a local SQLite file and a handful of small JSON writes --
# bound it anyway so a stuck lock can't wedge a `systemctl --user` call.
TimeoutStartSec=60
