# Re-arms agent-lcars-session-title-import.service every 2 minutes. See
# that unit and docker-compose.yml's AGENT_TELEMETRY_SESSION_STATE_DIR
# comment for why this import runs on the host at all (issue #1212).
#
# 2 minutes, not tighter: this is a background freshness refresh for
# `generated`-tier titles, not a liveness signal anything blocks on -- the
# watcher ticks far more often (AGENT_TELEMETRY_HEARTBEAT_INTERVAL_MS,
# default 10s) and just picks up whatever native-titles/ currently holds.
[Unit]
Description=Periodic Codex native session-title import for Agent LCARS
Documentation=https://github.com/jlapenna/agent-lcars/blob/main/apps/telemetry-watcher/deploy/README.md

[Timer]
# No Persistent=true here: it only affects OnCalendar= timers (systemd
# tracks and replays a missed *calendar* trigger; monotonic triggers like
# OnBootSec=/OnUnitActiveSec= have no persisted last-trigger-time to replay
# from, so Persistent= is a silent no-op on this timer type). OnBootSec=2min
# already covers the case this would otherwise be reaching for -- an import
# runs shortly after every boot regardless of how long the host was down.
OnBootSec=2min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
