# Optional host-specific Compose overrides. The production project id defaults
# to agent-lcars when this file is absent; never commit a real .env file.
AGENT_TELEMETRY_PROJECT_ID=agent-lcars

# AGENT_TELEMETRY_CHECKOUT_ROOTS is supplied to deploy.sh itself rather than
# through this Compose-only file. Every comma-separated absolute root must
# resolve under the watched user's ~/p tree, which is the checkout mount the
# container can access.

# The writer SA key itself is NOT an env var here (it's a JSON blob, awkward
# in dotenv format) — it's a separate file at
# $HOME/agent-lcars-telemetry-watcher/writer-key.json on each watcher host.
# Source of truth is jlapenna/homelab's encrypted vault (agent_lcars_writer_key_json),
# synced here by that repo's ansible/sync_agent_lcars_writer_key.yml -- see
# deploy/README.md's "Secrets" section for the full pipeline and the
# hand-placed fallback:
#   gcloud secrets versions access latest \
#     --project=agent-lcars \
#     --secret=AGENT_TELEMETRY_WRITER_KEY_JSON \
#     > "$HOME/agent-lcars-telemetry-watcher/writer-key.json"
#   chmod 600 "$HOME/agent-lcars-telemetry-watcher/writer-key.json"
# deploy.sh checks for this file and fails with instructions if it's
# missing.
