# Copy to .env (never commit .env itself).
AGENT_TELEMETRY_PROJECT_ID=agent-lcars

# The writer SA key itself is NOT an env var here (it's a JSON blob, awkward
# in dotenv format) — it's a separate file at
# /home/homelab/agent-lcars-telemetry-watcher/writer-key.json on pike,
# hand-fetched (same convention as homelab's github-runner RUNNER_TOKEN
# .env; see deploy/README.md's "Owner TODO" for automating this):
#   gcloud secrets versions access latest \
#     --project=agent-lcars \
#     --secret=AGENT_TELEMETRY_WRITER_KEY_JSON \
#     > /home/homelab/agent-lcars-telemetry-watcher/writer-key.json
#   chmod 600 /home/homelab/agent-lcars-telemetry-watcher/writer-key.json
# deploy.sh checks for this file and fails with instructions if it's
# missing.
