# Optional host-specific Compose overrides. The production project id defaults
# to agent-lcars when this file is absent; never commit a real .env file.
AGENT_TELEMETRY_PROJECT_ID=agent-lcars

# --- Required identity inputs (issue #1732) ---------------------------------
# deploy.sh sources this file before resolving these -- set them here, or
# directly in the invoking environment. There is no maintainer default for
# any of the three: every deploying fleet has its own watcher account,
# checkout layout, and registry mirror.
#
# AGENT_TELEMETRY_WATCHER_USER=example-service-account
#
# AGENT_TELEMETRY_CHECKOUT_ROOTS=/home/example-service-account/p/agent-lcars,/home/example-service-account/p/homelab
#
# AGENT_TELEMETRY_IMAGE_REGISTRY=docker-registry.example.internal

# Optional (issue #1732): rename aliases for repos this fleet has renamed,
# whose local `origin` remotes may still report the pre-rename `owner/name`.
# JSON object of `"owner/name"` -> `{"owner": ..., "name": ...}`. Absent or
# empty means no aliases apply -- most fleets need none.
#
# AGENT_TELEMETRY_REPO_ALIASES={"old-owner/old-name":{"owner":"new-owner","name":"new-name"}}

# The writer SA key itself is NOT an env var here (it's a JSON blob, awkward
# in dotenv format) — it's a separate file at
# $HOME/agent-lcars-telemetry-watcher/writer-key.json on each watcher host.
# Source of truth is your fleet's own encrypted secret store
# (agent_lcars_writer_key_json) -- see deploy/README.md's "Secrets" section
# for a worked example pipeline and the hand-placed fallback:
#   gcloud secrets versions access latest \
#     --project=agent-lcars \
#     --secret=AGENT_TELEMETRY_WRITER_KEY_JSON \
#     > "$HOME/agent-lcars-telemetry-watcher/writer-key.json"
#   chmod 600 "$HOME/agent-lcars-telemetry-watcher/writer-key.json"
# deploy.sh checks for this file and fails with instructions if it's
# missing.
