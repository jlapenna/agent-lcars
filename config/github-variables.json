{
  "version": 1,
  "profiles": {
    "agent-lcars": {
      "repositories": ["jlapenna/agent-lcars"],
      "variables": {
        "E2E_ENABLED": {
          "class": "lane",
          "default": "true"
        },
        "AGENT_FLEET_LOGIN": {
          "class": "shared-input",
          "required": true
        },
        "AGENT_LCARS_CLIENT_ID": {
          "class": "shared-input",
          "required": true
        },
        "APPHOSTING_BACKEND_ID": {
          "class": "shared-input",
          "required": true
        },
        "GCP_CODEX_AGENT_SA": {
          "class": "shared-input",
          "required": true
        },
        "GCP_DEPLOYER_SA": {
          "class": "shared-input",
          "required": true
        },
        "GCP_DEPLOYER_WIF_PROVIDER": {
          "class": "shared-input",
          "required": true
        },
        "GCP_PROJECT_ID": {
          "class": "shared-input",
          "required": true
        },
        "GCP_TELEMETRY_WRITER_SA": {
          "class": "shared-input",
          "required": true
        },
        "GCP_WEBHOOK_CONFIG_SA": {
          "class": "shared-input",
          "required": true
        },
        "GCP_WEBHOOK_CONFIG_WIF_PROVIDER": {
          "class": "shared-input",
          "required": true
        },
        "GCP_WIF_PROVIDER": {
          "class": "shared-input",
          "required": true
        },
        "AGENT_BOT_LOGINS": {
          "class": "shared-input",
          "required": false
        },
        "CI_LOG_LOKI_URL": {
          "class": "shared-input",
          "required": false
        },
        "NX_CACHE_URL": {
          "class": "shared-input",
          "required": false
        },
        "AGENT_LCARS_RUNNER_APP_CLIENT_ID": {
          "class": "shared-input",
          "required": false
        },
        "LEGACY_RUNNER_APP_CLIENT_ID": {
          "class": "shared-input",
          "required": false
        },
        "LEGACY_RUNNER_APP_INSTALLATION_ID": {
          "class": "shared-input",
          "required": false
        }
      }
    },
    "sprinkles": {
      "repositories": ["supersprinklesracing/sprinkles"],
      "variables": {
        "E2E_ENABLED": {
          "class": "lane",
          "default": "true"
        },
        "E2E_VISUAL_ENABLED": {
          "class": "lane",
          "default": "true"
        },
        "POST_SUBMIT_ARMED": {
          "class": "armed",
          "default": "false"
        },
        "DEPLOY_ARMED": {
          "class": "armed",
          "default": "false"
        },
        "VISUAL_REFRESH_DISPATCH_ARMED": {
          "class": "armed",
          "default": "false"
        },
        "AGENT_FLEET_LOGIN": {
          "class": "shared-input",
          "required": true
        }
      }
    },
    "fleet-member": {
      "repositories": [
        "jlapenna/homelab",
        "supersprinklesracing/www",
        "supersprinklesracing/girosf",
        "jlapenna/nx-cache-server",
        "jlapenna/sync-padd"
      ],
      "variables": {
        "AGENT_FLEET_LOGIN": {
          "class": "shared-input",
          "required": true
        }
      }
    }
  }
}
